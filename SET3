Cake Bill Program

cakes = ["Chocolate", "Vanilla", "Strawberry", "Red Velvet", "Black Forest"]
prices = [100, 80, 90, 120, 110]  # prices per cake
total = 0
for i in range(len(cakes)):
    qty = int(input(f"Quantity of {cakes[i]} cakes: "))
    total += qty * prices[i]
print(f"Original total: ₹{total}")
discount = 0
if total > 500:
    discount = total * 0.10
final = total - discount
print(f"Discount amount: ₹{discount}")
print(f"Final amount: ₹{final}")

