3) Print OH / AH / OHAH (Multiples of 3 and 5)

x = int(input("Enter starting number: "))
y = int(input("Enter ending number: "))

for num in range(x, y + 4) :
    if num % 3 == 0 and num % 5 == 0:
        print("OHAH", end=" ")
    elif num % 3 == 0:
        print("OH", end=" ")
    elif num % 5 == 0:
        print("AH", end=" ")
    else:
        print(num, end=" ")
